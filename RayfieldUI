--=======================================================
-- 18. BASIC LUA / LUAU SYNTAX
--=======================================================

-- VARIABLES

local Name = "Example"
local Number = 100
local Enabled = true


-- FUNCTIONS

local function MyFunction()
    print("Hello!")
end

MyFunction()


-- CALLBACKS

local function OnButtonClicked()
    print("Button pressed!")
end


-- IF STATEMENTS

if Enabled then
    print("Enabled")
else
    print("Disabled")
end


-- TABLES

local Options = {
    "First",
    "Second",
    "Third"
}

print(Options[1])


-- LOOPS

for _, Option in ipairs(Options) do
    print(Option)
end


-- WHILE LOOP

local Count = 1

while Count <= 5 do
    print(Count)
    Count += 1
end


-- BOOLEAN VALUES

local IsEnabled = true

if IsEnabled == true then
    print("It is enabled")
end


